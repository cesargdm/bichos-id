{
	"name": "bichos-id",
	"private": true,
	"scripts": {
		"native": "cd apps/expo && bun run start",
		"web": "cd apps/next && bun run next",
		"prebuild": "cd apps/expo && bun run prebuild",
		"lint": "oxlint --type-aware",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"clean": "turbo clean",
		"licenses": "turbo licenses",
		"typecheck": "turbo typecheck"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"devDependencies": {
		"oxfmt": "~0.66.0",
		"oxlint": "~1.81.0",
		"oxlint-tsgolint": "~7.0.2001",
		"turbo": "~2.10.5"
	}
}
