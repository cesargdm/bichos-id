# Content-hashed build output — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not hash-versioned, but rarely change.
/*.png
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
