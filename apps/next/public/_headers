# Content-hashed build output — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not hash-versioned, but rarely change. Listed explicitly rather than by
# extension: a `/*.svg`-style rule also matches _next/static/**/*.svg, and the
# two rules then both apply, emitting a doubled Cache-Control header.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-16x16.png
  Cache-Control: public, max-age=86400
/favicon-32x32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/android-chrome-192x192.png
  Cache-Control: public, max-age=86400
/android-chrome-512x512.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
